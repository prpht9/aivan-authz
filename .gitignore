.session.vim
/bin
/.grok
/images
/videos
/scratch
/seed

# An older `authz-admin relay-keygen` wrote the service key pair here. The tool
# now writes ~/.config/aivan/keys (AIVAN_SERVICE_KEY_DIR, or --dir). Nothing in
# this directory is tracked: a private half left behind still signs registrations
# with aivan-approval, and a key in git is a key that can enrol a device against
# any user id at the relay. The README is the one exception, so the directory
# exists with an explanation rather than appearing as an unexplained empty path.
/config/*
!/config/README.md

# The root CA's public certificate is tracked in deploy/ca. Its private key
# never enters this repository: a key here would let anyone mint a certificate
# for any host in the house. Refuse the shapes a stray copy takes.
*.key
*.pem
!deploy/ca/*.crt
